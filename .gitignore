-- [LÓGICA DE COMBATE E FARM]
_G.AutoFarmLevel = false
_G.AutoFarmNearest = false
_G.AutoRandomFruit = false

local function Attack()
    local character = game.Players.LocalPlayer.Character
    if not character then return end
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
        -- Simula combo disparando o remote de ataque se disponível
        local args = { [1] = "Attack", [2] = "Combat" }
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer(unpack(args))
    end
end

local function GetNearestEnemy()
    local closest = nil
    local dist = math.huge
    local player = game.Players.LocalPlayer
    
    -- Busca em todo o Workspace para cobrir pastas de ilhas diferentes
    for _, v in pairs(game.Workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v ~= player.Character then
            if v.Humanoid.Health > 0 then
                local magnitude = (player.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).magnitude
                if magnitude < dist then
                    dist = magnitude
                    closest = v
                end
            end
        end
    end
    return closest
end

local function AutoQuest()
    local player = game.Players.LocalPlayer
    -- Busca por NPCs que tenham 'Quest' no nome em qualquer parte do mapa
    for _, v in pairs(game.Workspace:GetDescendants()) do
        if v:IsA("Model") and v.Name:find("Quest") and v:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame
            wait(0.5)
            -- Tenta aceitar a quest disponível para o level atual via Remote
            local args = { [1] = "AcceptQuest" }
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer(unpack(args))
            break
        end
    end
end

-- [BOTÕES FUNCIONAIS]
local function CreateToggle(name, callback)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0, 200, 0, 40)
    Button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    Button.Text = name .. ": OFF"
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.Parent = ScrollingFrame
    
    local state = false
    Button.MouseButton1Click:Connect(function()
        state = not state
        Button.Text = name .. (state and ": ON" or ": OFF")
        Button.BackgroundColor3 = state and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
        callback(state)
    end)
end

CreateToggle("Auto Farm Level", function(state)
    _G.AutoFarmLevel = state
    spawn(function()
        while _G.AutoFarmLevel do
            wait(0.1)
            AutoQuest()
            local target = GetNearestEnemy()
            if target then
                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                Attack()
            end
        end
    end)
end)

CreateToggle("Auto Farm Nearest", function(state)
    _G.AutoFarmNearest = state
    spawn(function()
        while _G.AutoFarmNearest do
            wait(0.1)
            local target = GetNearestEnemy()
            if target then
                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                Attack()
            end
        end
    end)
end)

CreateToggle("Auto Random Fruit", function(state)
    _G.AutoRandomFruit = state
    spawn(function()
        while _G.AutoRandomFruit do
            wait(1)
            for _, v in pairs(game.Workspace:GetChildren()) do
                if v.Name:find("Fruit") and v:FindFirstChild("Handle") then
                    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.Handle.CFrame
                    wait(0.2)
                end
            end
        end
    end)
end)

CreateToggle("Auto Second Sea", function(state)
    if state then
        -- Teleporta para o NPC de transição do Sea 1 para o Sea 2
        local npc = game.Workspace:FindFirstChild("MilitaryDetective") 
        if npc then
            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = npc.HumanoidRootPart.CFrame
            print("SOUZA: Interagindo com NPC do Sea 2...")
        end
    end
end)

CreateToggle("Auto Third Sea", function(state)
    if state then
        -- Teleporta para o NPC de transição do Sea 2 para o Sea 3
        local npc = game.Workspace:FindFirstChild("TradeNPC") 
        if npc then
            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = npc.HumanoidRootPart.CFrame
            print("SOUZA: Interagindo com NPC do Sea 3...")
        end
    end
end)
